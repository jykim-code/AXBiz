# 로컬 개발용 환경변수 샘플.
# 이 파일을 복사해 `.dev.vars` 로 저장하고 값을 채운다. (.dev.vars 는 커밋 금지)
#   cp .dev.vars.example .dev.vars
#
# 관리자 페이지(/admin) 쓰기 요청을 검증하는 숫자 PIN.
ADMIN_PIN=1234

# RAG 답변 생성용 LLM (OpenRouter). 임베딩은 Workers AI 바인딩이라 키 불필요.
#   - OPENROUTER_API_KEY: https://openrouter.ai/keys 에서 발급
#   - OPENROUTER_MODEL  : 사용할 챗 모델 슬러그 (크레딧 0이면 `:free` 모델)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
