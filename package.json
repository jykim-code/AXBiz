{
  "name": "ax-biz-radar",
  "version": "1.0.0",
  "private": true,
  "description": "사내 AX 경쟁사 동향 대시보드 (Cloudflare Pages + D1)",
  "scripts": {
    "dev": "wrangler pages dev public",
    "d1:create": "wrangler d1 create ax-biz-radar",
    "d1:local": "wrangler d1 execute ax-biz-radar --local --file=./schema.sql",
    "d1:remote": "wrangler d1 execute ax-biz-radar --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
